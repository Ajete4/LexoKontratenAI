{
  "name": "lexokontraten-api",
  "version": "0.1.0",
  "private": true,
  "description": "Local MVP backend for LexoKontraten AI",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
