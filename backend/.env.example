NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Add real values only to backend/.env. Never expose server-side secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI is optional at startup and required only when AI analysis is invoked.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT_MS=45000
